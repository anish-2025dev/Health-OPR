# Copy to .env and fill in development values. NEVER commit .env.
# In Codespaces, put real credentials in GitHub Codespaces Secrets instead.
# The placeholder values below are not secrets; replace them everywhere except local dev.

# --- Application ---
APP_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET_KEY=change-me-dev-only
API_PORT=4000
FRONTEND_URL=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
LOG_LEVEL=info

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=healthos
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=healthos
POSTGRES_PORT=5432
DATABASE_URL=postgres://healthos:change-me-dev-only@localhost:5432/healthos
# Optional: separate direct (non-pooled) connection for migrations. Falls back to DATABASE_URL.
# On Neon: DATABASE_URL = pooled host (contains "-pooler"), DATABASE_MIGRATION_URL = direct host.
# Staging/production URLs must include ?sslmode=require (or verify-full); the API refuses to start otherwise.
DATABASE_MIGRATION_URL=

# --- Redis (docker compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Frontend (Vite exposes only VITE_* vars to the browser; never put secrets here) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Integrations (later phases; leave empty in development) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
S3_BUCKET=
AWS_REGION=ap-south-1
