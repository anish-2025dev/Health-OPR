# Copy to .env and fill in development values. NEVER commit .env.
# In Codespaces, put real credentials in GitHub Codespaces Secrets instead.
# The placeholder values below are not secrets; replace them everywhere except local dev.

# --- Application ---
APP_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET_KEY=change-me-dev-only
API_PORT=4000
FRONTEND_URL=http://localhost:5173
# Patient website (separate site; `npm run dev` serves it on 5174). Used for CORS and patient links.
PATIENT_SITE_URL=http://localhost:5174
# How long a patient stays signed in on a device (days).
PATIENT_SESSION_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
LOG_LEVEL=info

# --- PostgreSQL (docker compose) ---
# Local superuser, for administration only. The API never connects as it.
POSTGRES_USER=healthos_admin
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=healthos
POSTGRES_PORT=5432
# Non-superuser role the API connects as. Row-level security doesn't apply to superusers,
# so the app must use a normal role (like Neon's owner role) for tenant isolation to work.
POSTGRES_APP_USER=healthos_app
POSTGRES_APP_PASSWORD=change-me-dev-only
DATABASE_URL=postgres://healthos_app:change-me-dev-only@localhost:5432/healthos
# Integration tests create and reset their own database; defaults to DATABASE_URL with /healthos_test.
TEST_DATABASE_URL=
# Optional: separate direct (non-pooled) connection for migrations. Falls back to DATABASE_URL.
# On Neon: DATABASE_URL = pooled host (contains "-pooler"), DATABASE_MIGRATION_URL = direct host.
# Staging/production URLs must include ?sslmode=require (or verify-full); the API refuses to start otherwise.
DATABASE_MIGRATION_URL=

# --- Redis (docker compose) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Frontend (Vite exposes only VITE_* vars to the browser; never put secrets here) ---
# Same-origin path: Vite proxies /api to the API in development; Render rewrites /api in production.
VITE_API_BASE_URL=/api/v1
# Public URL of the patient website (clinic QR code and tracking links point here).
VITE_PATIENT_SITE_URL=http://localhost:5174

# --- Integrations (later phases; leave empty in development) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# SMS for employee OTPs (sign-in and attendance). Use 'console' locally: the OTP is printed to the
# API terminal. Deployed environments must use 'msg91' with a DLT-approved OTP template whose
# variable name matches MSG91_OTP_VARIABLE.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VARIABLE=otp
# Optional: SMS appointment confirmations (fallback when WhatsApp isn't allowed). A separate
# DLT-approved template; list its four variable names in this order: token, date, time, link.
MSG91_APPOINTMENT_TEMPLATE_ID=
MSG91_APPOINTMENT_VARIABLES=token,date,time,link
# Optional: SMS telling an employee a new in-app message is waiting (no content). Separate DLT
# template; its two variable names in order: organization name, link.
MSG91_MESSAGE_ALERT_TEMPLATE_ID=
MSG91_MESSAGE_ALERT_VARIABLES=org,link

# --- WhatsApp Business Platform (Meta Cloud API) ---
# meta in deployed environments; console prints messages locally; empty = off.
WHATSAPP_PROVIDER=
# System-user access token from Meta Business Settings (secret; never commit a real value)
WHATSAPP_ACCESS_TOKEN=
# App secret from the Meta app dashboard, used to verify webhook signatures (secret)
WHATSAPP_APP_SECRET=
# Any random string you choose; enter the same value when subscribing the webhook in Meta
WHATSAPP_VERIFY_TOKEN=
# Graph API version shown in your Meta app dashboard (e.g. v21.0)
WHATSAPP_GRAPH_API_VERSION=
# Approved template for appointment confirmations; body parameters: token, date, time, link
WHATSAPP_APPOINTMENT_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
MSG91_SENDER_ID=
S3_BUCKET=
AWS_REGION=ap-south-1
