{
  "name": "healthos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Healthcare Operations OS: multi-tenant SaaS for hospitals, clinics and nursing homes.",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:rollback": "npm run db:rollback --workspace apps/api",
    "db:make": "npm run db:make --workspace apps/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
