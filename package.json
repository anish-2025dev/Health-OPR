{
  "name": "healthos-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Healthcare Operations OS: multi-tenant SaaS for hospitals, clinics and nursing homes.",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web,patient -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:patient\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "test:mgt": "npm run test:mgt --workspace apps/api && npm run test:mgt --workspace apps/web",
    "test:ops": "npm run test:ops --workspace apps/api && npm run test:ops --workspace apps/web",
    "test:platform": "npm run test:platform --workspace apps/api && npm run test:platform --workspace apps/web",
    "test:api": "npm run test --workspace apps/api",
    "test:web": "npm run test --workspace apps/web",
    "build": "npm run build --workspace apps/web && npm run build:patient --workspace apps/web",
    "build:mgt": "npm run build:mgt --workspace apps/web",
    "build:ops": "npm run build:ops --workspace apps/web",
    "build:patient": "npm run build:patient --workspace apps/web",
    "build:platform": "npm run build:platform --workspace apps/web",
    "build:all": "npm run build && npm run build:all --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:rollback": "npm run db:rollback --workspace apps/api",
    "db:make": "npm run db:make --workspace apps/api --",
    "dev:patient": "npm run dev:patient --workspace apps/web",
    "seed:demo": "npm run seed:demo --workspace apps/api --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
